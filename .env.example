# Local demo only. NEVER enable demo mode on production.
ENABLE_DEMO_MODE=true

# Public web origin, HTTPS required on production.
APP_BASE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_GITHUB_USERS=tejavallabhaneni

# Dedicated Supabase PostgreSQL project: apply db/schema.sql and db/002_worker.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Separate SitecoreAI Environment Automation clients, with appropriate access.
SITECORE_SOURCE_HOST=source-environment.sitecorecloud.io
SITECORE_SOURCE_CLIENT_ID=
SITECORE_SOURCE_CLIENT_SECRET=
SITECORE_DESTINATION_HOST=destination-environment.sitecorecloud.io
SITECORE_DESTINATION_CLIENT_ID=
SITECORE_DESTINATION_CLIENT_SECRET=

# Set TRUE ONLY in a private, verified staging worker environment:
ENABLE_LIVE_TRANSFERS=false
