# No database or application-owned content history. All source and transfer
# history is requested directly from your two configured SitecoreAI environments.

# HTTPS public origin for Vercel production, or local http://localhost:3000
APP_BASE_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_GITHUB_USERS=tejavallabhaneni

# Each deployment is configured against environments that its operator owns.
# These are server-side secrets in Vercel; do not expose via NEXT_PUBLIC_*.
SITECORE_SOURCE_HOST=source-environment.sitecorecloud.io
SITECORE_SOURCE_CLIENT_ID=
SITECORE_SOURCE_CLIENT_SECRET=
SITECORE_DESTINATION_HOST=destination-environment.sitecorecloud.io
SITECORE_DESTINATION_CLIENT_ID=
SITECORE_DESTINATION_CLIENT_SECRET=

# Real transfer execution remains opt-in and bounded by Vercel function duration.
ENABLE_LIVE_TRANSFERS=false
