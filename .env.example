# Optional. If supplied, must exactly match the current deployment origin.
# Leave unset for automatic same-origin request validation.
# APP_BASE_URL=https://sitecoreai-ae-content-transfer-app.vercel.app

# Public workflow: visitors supply their own Sitecore environment credentials.
# No shared Sitecore client secrets, GitHub OAuth, PostgreSQL, or worker required.

# Optional Sitecore sign-in. One registered SPA client for this application;
# end users do not supply a client secret. API access must be granted and tested.
# NEXT_PUBLIC_SITECORE_AUTH_CLIENT_ID=your-registered-public-spa-client-id
# Set the audience approved for your registration. Do not assume a Marketplace
# interactive token is interchangeable with a direct environment automation token.
# NEXT_PUBLIC_SITECORE_AUTH_AUDIENCE=https://api.sitecorecloud.io
# NEXT_PUBLIC_SITECORE_AUTH_SCOPE=openid profile email
# NEXT_PUBLIC_SITECORE_ORGANIZATION_ID=optional-organization-context
