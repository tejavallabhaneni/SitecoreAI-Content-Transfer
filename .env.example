# Local development demo (never enabled in production)
ENABLE_DEMO_MODE=true

# Public server origin (HTTPS required in production)
APP_BASE_URL=http://localhost:3000

# Create a GitHub OAuth App with callback:
# ${APP_BASE_URL}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_GITHUB_USERS=tejavallabhaneni

# Supabase-managed PostgreSQL (server-only service-role key).
# Run db/schema.sql in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Each environment requires SitecoreAI Environment Automation credentials.
SITECORE_SOURCE_HOST=source-environment.sitecorecloud.io
SITECORE_SOURCE_CLIENT_ID=
SITECORE_SOURCE_CLIENT_SECRET=
SITECORE_DESTINATION_HOST=destination-environment.sitecorecloud.io
SITECORE_DESTINATION_CLIENT_ID=
SITECORE_DESTINATION_CLIENT_SECRET=
